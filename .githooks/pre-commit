#!/bin/sh
# Refuse to commit anything that looks like an API key. Enable once per clone with:
#   git config core.hooksPath .githooks
files=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$files" ] && exit 0
python3 scripts/check_secrets.py $files || {
  echo "Commit blocked by the secret scan (.githooks/pre-commit)."; exit 1; }
